# Dashboard environment
# NEXT_PUBLIC_API_BASE_URL: client-side API path prefix
# Use /api for same-origin proxy (no CORS needed)
# Use http://localhost:8000 for direct backend calls (needs CORS on backend)
NEXT_PUBLIC_API_BASE_URL=/api

# API_BASE_URL: server-side rewrite target for Next.js proxy
# Only used when NEXT_PUBLIC_API_BASE_URL=/api
API_BASE_URL=http://localhost:8000
