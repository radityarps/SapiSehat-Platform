# FastAPI Configuration
FASTAPI_ENV=development
DEBUG=true

# Model Configuration
MODEL_PATH=./model/tes1_best.keras
MODEL_CLASS_NAMES_PATH=./model/class_names.json
DEVICE=cpu

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
REQUEST_TIMEOUT=60

# Security
# JWT_SECRET must be a strong (>=32 char) secret in production.
JWT_SECRET=sapisehat-dev-token-secret
# Comma-separated allowed origins. Wildcard (*) is rejected in production.
CORS_ORIGINS=

# Media / S3 (MinIO in development)
MEDIA_MAX_UPLOAD_BYTES=10485760
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sapisehat-scan-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true


# Logging
LOG_LEVEL=info

# Rate limiting
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60

# Two-stage inference (optional)
TWO_STAGE_ENABLED=false
TWO_STAGE_DEBUG_REGIONS=false

# Seeding
# SEED_TIER controls what data is seeded on startup. Defaults to FASTAPI_ENV when unset.
#   production  = master admin account only
#   staging     = admin + district officer + 2 farmer accounts
#   development = staging accounts + sample cattle/detections/risk-signals/follow-ups
SEED_TIER=development
# Master admin account (seeded in every tier). Use strong credentials in production.
MASTER_ADMIN_EMAIL=admin@sapisehat.id
MASTER_ADMIN_PASSWORD=admin123
MASTER_ADMIN_NAME=Admin Agency
MASTER_ADMIN_JURISDICTION=central-java
